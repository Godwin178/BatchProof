# Copy to contracts/.env before deploying. Never commit the real file.
# Use a dedicated testnet-only wallet — never a production private key.

# Any Arbitrum Sepolia JSON-RPC endpoint (e.g. Alchemy, Infura, Ankr).
ARBITRUM_SEPOLIA_RPC_URL=

# Private key of the deployer wallet. Must hold Arbitrum Sepolia testnet ETH.
DEPLOYER_PRIVATE_KEY=
