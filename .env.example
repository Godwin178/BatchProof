# ============================================================
# BatchProof — environment variables
# Copy this file to `.env.local` (Next.js) and fill in values.
# Never commit real keys, tokens or private keys.
# ============================================================

# ---- Supabase (required) ----
# Supabase dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ---- App (required) ----
# Public base URL used inside QR codes and verification links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Blockchain (optional) ----
# After deploying BatchProofRegistry to Arbitrum Sepolia (see SETUP.md),
# paste the deployed contract address here to enable on-chain anchoring.
NEXT_PUBLIC_BATCH_REGISTRY_ADDRESS=
NEXT_PUBLIC_CHAIN_ID=421614
